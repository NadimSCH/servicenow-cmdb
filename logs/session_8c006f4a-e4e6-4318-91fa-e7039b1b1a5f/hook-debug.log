          "+    def _validate_action(self) -> None:",
          "+        \"\"\"Validate action is one of the five defined choice values.\"\"\"",
          "+        valid_actions = {",
          "+            \"Create Incident\",",
          "+            \"Update Incident\",",
          "+            \"Update RITM\",",
          "+            \"Create/Update CI\",",
