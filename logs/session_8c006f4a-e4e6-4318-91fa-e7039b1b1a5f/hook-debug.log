ield has a value\n    if self.timeout is not None and self.timeout < 1:\n        exc = DataValidationError(\"timeout must be >= 1\")\n        extension_manager.add_error(exc, field=\"timeout\", value=self.timeout)\n```\n\n### Conditional Validation (Field Visibility)\n\n**Only validate fields when they're actually visible/required based on form state**\n\nWhen fields have visibility conditions (e.g., shown only when another field has a specific value), validation should be conditional:\n\n```python\ndef _validate_coordinates(self):\n    # DON'T validate unconditionally - check if this location method is selected\n    # WRONG: if self.latitude is not None:\n\n    # CORRECT: Only validate when coordinates location method is selected\n    if self.location_method and self.location_method.value == \"coordinates\":\n        # Now validate latitude/longitude if they're required for this method\n        if not self.latitude or not self.longitude:\n            exc = DataValidationError(\"Latitude and longitude required for coordinates method\")\n            extension_manager.add_error(exc, field=\"latitude\")\n\ndef _validate_zip_code(self):\n    # Only validate zip code when zip location method is selected\n    if self.location_method and self.location_method.value == \"zip\":\n        # UAC sends empty strings for hidden fields, check for both None and empty\n        if not self.zip_code or self.zip_code == \"\":\n            exc = DataValidationError(\"Zip code required for zip method\")\n            extension_manager.add_error(exc, field=\"zip_code\")\n\ndef _validate_city(self):\n    # Only validate city/country when city location method is selected\n    if self.location_method and self.location_method.value == \"city\":\n        if not self.country or not self.city:\n            exc = DataValidationError(\"Country and city required for city method\")\n            extension_manager.add_error(exc, field=\"city\")\n```\n\n**Pattern for Conditional Validation:**\n\n1. **Check the controlling field** (e.g., location_method, action)\n2. **Only validate dependent fields if the controlling field matches**\n3. **Check for both None and empty strings** (UAC sends empty strings for hidden fields)\n\n```python\n# General pattern\ndef _validate_conditional_field(self):\n    # Step 1: Check if this field should be visible/required\n    if self.controlling_field and self.controlling_field.value == \"expected_value\":\n        # Step 2: Now validate the conditional field\n        if not self.conditional_field or self.conditional_field == \"\":\n            exc = DataValidationError(\"Field required when X is selected\")\n            extension_manager.add_error(exc, field=\"conditional_field\")\n```\n\n### Example with Required Field\n\nEven if a field is marked as `required: true` in template.json, **still check for None** in validation:\n\n```python\ndef _validate_action(self):\n    # Check for None even though action is \"required\" in template.json\n    # UAC enforces this, but defensive coding is good practice\n    if self.action is not None and self.action.value not in [\"create\", \"delete\"]:\n        exc = DataValidationError(f\"Invalid action: {self.action.value}\")\n        extension_manager.add_error(exc, field=\"action\")\n```\n\n## Previous Output (Re-run Support)\n\nWhen extension is re-run, previous OutputFields are automatically available:\n\n```python\ndef my_action(input_data: InputFields):\n    # Access previous run data\n    if input_data.previous_output:\n        last_id = input_data.previous_output.last_processed_id\n        resume_from(last_id)\n\n    # Process...\n```\n\n## Skip Validation\n\nUsed internally for error reporting when validation fails:\n\n```python\n# In extension.py exception handler\ntry:\n    input_data = InputFields(**processed_fields)\nexcept ExecutionError as e:\n    # Create InputFields without validation for error reporting\n    input_data = InputFields(**processed_fields, _skip_validation=True)\n    return self.build_result(input_fields=input_data, ...)\n```\n\n## Converting to Dictionary (to_dict)\n\nThe `to_dict()` method converts InputFields to a dictionary, automatically excluding:\n- Internal fields (`_skip_validation`)\n- Empty/None `previous_output`\n\n```python\n# In extension.py build_result()\ninput_dict = input_fields.to_dict()\n# Returns clean dict without internal fields or empty previous_output\n```\n\nThis is used by `build_result()` to create the `unv_output` structure.\n\n## Field Customization\n\nDefine your extension's fields using wrapper types:\n\n```python\nfrom fields.types import SingleChoice, Text, Integer, MultiChoice, Credential, Script\n\n@dataclass\nclass InputFields:\n    # User-defined fields - ALWAYS Optional\n    action: Optional[SingleChoice] = None\n    resource_name: Optional[Text] = None\n    timeout: Optional[Integer] = None\n    tags: Optional[MultiChoice] = None\n\n    # Credentials\n    api_credential: Optional[Credential] = None\n\n    # Script fields - use Script type (UAC returns temporary file path)\n    sql_query: Optional[Script] = None\n    json_payload: Optional[Script] = None\n\n    # Control fields\n    stdout_options: Optional[MultiChoice] = None\n    output_options: Optional[MultiChoice] = None\n\n    # Auto-populated\n    previous_output: Optional[OutputFields] = None\n    _skip_validation: bool = False\n```\n\n### Script Field Type Guidelines\n\n**IMPORTANT:** Script Fields in UAC templates (e.g., `\"Script Field 1-4\"`) return a **temporary file path**, not the content directly.\n\n**Type Definition:**\n- Use `Script` wrapper type from `fields.types` for script fields\n- Mark as `Optional[Script]` since script fields can be empty\n- Import: `from fields.types import Script`\n\n**Example:**\n```python\nfrom fields.types import Script\n\n@dataclass\nclass InputFields:\n    sql_query: Optional[Script] = None  # Script Field returns file path\n\n    def _validate_sql_query(self):\n        if self.sql_query and not self.sql_query.exists():\n            exc = DataValidationError(\"SQL query file not found\")\n            extension_manager.add_error(exc, field=\"sql_query\")\n```\n\n**Usage in Actions:**\n```python\ndef execute_query(input_data: InputFields):\n    if input_data.sql_query:\n        # Read the script content using Script wrapper methods\n        sql_content = input_data.sql_query.read()\n        # Or parse as JSON\n        json_data = input_data.sql_query.read_json()\n        # Process...\n```\n\nAdd corresponding validation methods:\n\n```python\ndef _validate_resource_name(self):\n    # ALWAYS check for None first\n    if self.resource_name is not None and len(self.resource_name.value) > 255:\n        exc = DataValidationError(\"resource_name too long\")\n        extension_manager.add_error(\n            exc,\n            field=\"resource_name\",\n            length=len(self.resource_name.value)\n        )\n```\n\nSee src/fields/input.py for full implementation and examples.",
